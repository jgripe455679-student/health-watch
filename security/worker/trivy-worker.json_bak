            "https://www.vulncheck.com/advisories/util-linux-libmount-privilege-escalation-via-failed-mount-helper"
          ],
          "PublishedDate": "2026-09-03T13:06:08.44Z",
          "LastModifiedDate": "2026-09-03T15:17:33.49Z"
