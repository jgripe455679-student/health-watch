          "Status": "fixed",
          "Layer": {
            "DiffID": "sha256:23cb786ca75efde961fecc5d5e6989a85ea0ae52bd7e96a43d3524ea3b4f91d2"
          },
          "SeveritySource": "ghsa",
          "PrimaryURL": "https://avd.aquasec.com/nvd/cve-2026-12876",
          "DataSource": {
