          "created_by": "RUN /bin/sh -c apt-get update     \u0026\u0026 apt-get upgrade -y gzip     \u0026\u0026 rm -rf /var/lib/apt/lists/* \u0026\u0026     groupadd --system app \u0026\u0026     useradd --system --gid app --create-home --home-dir /home/app app \u0026\u0026     chown -R app:app /app # buildkit",
