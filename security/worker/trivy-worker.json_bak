        {
          "VulnerabilityID": "CVE-2026-78408",
          "PkgID": "bsdutils@1:2.41.5-0+deb13u1",
          "PkgName": "bsdutils",
          "PkgIdentifier": {
            "PURL": "pkg:deb/debian/bsdutils@2.41.5-0%2Bdeb13u1?arch=amd64\u0026distro=debian-13.6\u0026epoch=1",
