        {
          "VulnerabilityID": "CVE-2026-5928",
          "PkgID": "libc-bin@2.41-12+deb13u3",
          "PkgName": "libc-bin",
          "PkgIdentifier": {
            "PURL": "pkg:deb/debian/libc-bin@2.41-12%2Bdeb13u3?arch=amd64\u0026distro=debian-13.6",
