            "https://nvd.nist.gov/vuln/detail/CVE-2026-78410",
            "https://www.cve.org/CVERecord?id=CVE-2026-78410"
          ],
          "PublishedDate": "2026-09-02T16:17:23.983Z",
          "LastModifiedDate": "2026-09-03T18:12:56.407Z"
