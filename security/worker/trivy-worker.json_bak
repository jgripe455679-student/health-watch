        {
          "VulnerabilityID": "CVE-2026-78408",
          "PkgID": "libuuid1@2.41.5-0+deb13u1",
          "PkgName": "libuuid1",
          "PkgIdentifier": {
            "PURL": "pkg:deb/debian/libuuid1@2.41.5-0%2Bdeb13u1?arch=amd64\u0026distro=debian-13.6",
            "UID": "67cba3b022acab2f"
