            "https://nvd.nist.gov/vuln/detail/CVE-2026-15534",
            "https://www.cve.org/CVERecord?id=CVE-2026-15534"
          ],
          "PublishedDate": "2026-08-09T18:16:42.8Z",
          "LastModifiedDate": "2026-08-28T15:42:20.06Z"
        },
