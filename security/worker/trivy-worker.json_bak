        {
          "VulnerabilityID": "CVE-2026-8376",
          "PkgID": "perl-base@5.40.1-6",
          "PkgName": "perl-base",
          "PkgIdentifier": {
            "PURL": "pkg:deb/debian/perl-base@5.40.1-6?arch=amd64\u0026distro=debian-13.6",
