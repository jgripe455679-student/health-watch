          ],
          "PkgName": "jaraco.context",
          "PkgPath": "usr/local/lib/python3.10/site-packages/setuptools/_vendor/jaraco.context-5.3.0.dist-info/METADATA",
          "PkgIdentifier": {
            "PURL": "pkg:pypi/jaraco.context@5.3.0",
